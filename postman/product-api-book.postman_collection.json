{
  "info": {
    "_postman_id": "d8f9aa91-61f4-4ec9-9da9-19f9e777a222",
    "name": "product-api-book",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Create product",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"productIdentifier\": \"{{productIdentifier}}\",\n  \"nome\": \"Teclado mecanico\",\n  \"descricao\": \"Teclado mecanico switch brown\",\n  \"preco\": 199.90,\n  \"category\": {\n    \"id\": {{categoryId}}\n  }\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/products",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "products"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 201', function () {",
              "  pm.response.to.have.status(201);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Get all products",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/products",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "products"
          ]
        }
      }
    },
    {
      "name": "Get products by category",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/products/categories/{{categoryId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "products",
            "categories",
            "{{categoryId}}"
          ]
        }
      }
    },
    {
      "name": "Get product by identifier",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/products/{{productIdentifier}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "products",
            "{{productIdentifier}}"
          ]
        }
      }
    },
    {
      "name": "Delete product by id",
      "request": {
        "method": "DELETE",
        "url": {
          "raw": "{{baseUrl}}/products/{{productId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "products",
            "{{productId}}"
          ]
        }
      }
    }
  ]
}
